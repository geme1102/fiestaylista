# ============================================
# FIESTA Y LISTA — ENV EXAMPLE (RAILWAY)
# ============================================
# Copia este contenido en Railway > Variables
# NUNCA uses localhost en producción
# ============================================

# === Base de datos (OBLIGATORIO) ===
DATABASE_URL=postgresql://postgres:password@localhost:5432/fiestaylista

# === JWT — genera secretos ÚNICOS (OBLIGATORIO) ===
# Ejecuta: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-this-to-a-random-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-this-to-another-random-secret
JWT_GUEST_SECRET=change-this-to-a-different-secret-for-guest-tokens

# === URLs (OBLIGATORIO) ===
# FRONTEND_URL: URL de Netlify (https://fiestaylista.com)
# BACKEND_URL: URL de Railway (https://tusubida.up.railway.app)
FRONTEND_URL=https://fiestaylista.com
BACKEND_URL=https://tusubida.up.railway.app
PORT=3001
NODE_ENV=production

# === Mercado Pago (OBLIGATORIO para PRO) ===
MERCADO_PAGO_ACCESS_TOKEN=APP_USR-...
MERCADO_PAGO_WEBHOOK_SECRET=...
# Precios en centavos (opcional — valores por defecto: 24990 y 288000)
PRO_MONTHLY_PRICE_CENTS=24990
PRO_YEARLY_PRICE_CENTS=288000

# === Email - Resend (OBLIGATORIO) ===
RESEND_API_KEY=re_...
FROM_EMAIL=Fiesta y Lista <noreply@fiestaylista.com>

# === Cloudinary (OBLIGATORIO para fotos) ===
CLOUDINARY_CLOUD_NAME=...
CLOUDINARY_API_KEY=...
CLOUDINARY_API_SECRET=...

# === Monitoreo (opcional) ===
SENTRY_DSN=https://...

# === Frontend (Netlify) ===
# Estas NO van en Railway, van en Netlify > Environment variables:
# VITE_API_URL=https://tusubida.up.railway.app
# VITE_APP_URL=https://fiestaylista.com
