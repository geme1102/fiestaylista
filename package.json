{
  "name": "fiesta-y-lista",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "build": "cd frontend && npm run build",
    "install:all": "cd backend && npm install && cd ../frontend && npm install",
    "db:generate": "cd backend && npm run db:generate",
    "db:migrate": "cd backend && npm run db:migrate",
    "db:push": "cd backend && npm run db:push",
    "db:backup": "bash scripts/backup-db.sh",
    "db:restore": "bash scripts/restore-db.sh",
    "test": "cd backend && npm test && cd ../frontend && npm test",
    "test:e2e": "cd frontend && npm run test:e2e",
    "prepare": "husky",
    "lint-staged": "lint-staged",
    "k6:checkout": "k6 run k6/checkout-stress.js",
    "k6:webhook": "k6 run k6/webhook-avalanche.js",
    "k6:mixed": "k6 run k6/mixed-traffic.js",
    "k6:general": "k6 run stress-test.js",
    "k6:checkout:staging": "k6 run -e BASE_URL=https://fiestaylista-staging.up.railway.app k6/checkout-stress.js",
    "k6:webhook:staging": "k6 run -e BASE_URL=https://fiestaylista-staging.up.railway.app k6/webhook-avalanche.js"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0"
  },
  "lint-staged": {
    "backend/src/**/*.ts": [
      "cd backend && npm run lint -- --fix",
      "cd backend && npm run typecheck"
    ],
    "frontend/src/**/*.ts": [
      "cd frontend && npm run lint -- --fix"
    ],
    "frontend/src/**/*.tsx": [
      "cd frontend && npm run lint -- --fix"
    ]
  }
}
