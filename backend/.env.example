# ============================================
# FIESTA Y LISTA — BACKEND ENV EXAMPLE
# ============================================
# Copia este archivo a .env y completa las variables
# NUNCA uses estos valores en producción
# ============================================

# === Base de datos (OBLIGATORIO) ===
# En Railway/Neon: usa -pooler en host para pooler transparente
# Ej: postgresql://user:pass@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb
DATABASE_URL=postgresql://postgres:password@localhost:5432/fiestaylista

# === JWT — genera secretos ÚNICOS para producción (OBLIGATORIO) ===
# Ejecuta: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-this-to-a-random-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-this-to-another-random-secret

# === URLs (OBLIGATORIO) ===
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3001
PORT=3001
NODE_ENV=development

# === Mercado Pago (OBLIGATORIO para pagos) ===
MERCADO_PAGO_ACCESS_TOKEN=
# El webhook secret debe coincidir con el configurado en el panel de MP
MERCADO_PAGO_WEBHOOK_SECRET=
# Precios en centavos (opcional — valores por defecto: 59900 y 660000)
PRO_MONTHLY_PRICE_CENTS=59900
PRO_YEARLY_PRICE_CENTS=660000

# === Email — Resend (OBLIGATORIO para verificación de email) ===
RESEND_API_KEY=
FROM_EMAIL=Fiesta y Lista <noreply@tudominio.com>

# === Cloudinary (OBLIGATORIO para subir fotos) ===
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# === JWT Expiración (opcional — valores por defecto) ===
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d
