# ================================================
# FIESTA Y LISTA — FRONTEND ENV EXAMPLE
# ================================================
# Copia este archivo a .env y completa las variables
# En producción (Netlify), configura estas como
# environment variables en el panel de Netlify
# ================================================

# === Frontend (OBLIGATORIO) ===
# En desarrollo: http://localhost:3001
# En producción (Netlify): URL del backend en Railway (ej: https://fiestaylista-production.up.railway.app)
VITE_API_URL=http://localhost:3001
# Opcional: Cloudflare Turnstile site key (seguridad en login y register)
# Obtener en: https://dash.cloudflare.com/?to=/:account/turnstile
# VITE_TURNSTILE_SITE_KEY=0x4...
# Opcional: Sentry (solo producción)
# VITE_SENTRY_DSN=https://...


